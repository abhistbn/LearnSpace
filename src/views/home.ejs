    <title>LearnSpace</title>
    <link rel="stylesheet" href="/css/home.css" />
  </head>
  <body>
    <!-- Floating Navigation -->
    <nav class="nav-container">
      <div class="nav-content">
        <a href="/" class="logo">LearnSpace</a>
        <ul class="nav-menu">
