    <section class="classes-section">
      <div class="classes-container">

        <div class="class-card">
          <div class="card-image">
            <img src="/images/kelas1.jpg" alt="gambar" class="card-img-custom">
          </div>
          <div class="card-content">
            <h3 class="card-title">UI/UX Beginner Class</h3>
            <p class="card-schedule">Senin - Jumat, 09:00 - 12:00</p>
