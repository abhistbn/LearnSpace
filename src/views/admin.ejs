<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Status Pembayaran</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            padding: 0 0 20px 0;
            margin: 0;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 60px;
        }

        .header {
            background-color: #bfbfbf;
            border-radius: 0 0 24px 24px;
            height: 120px;
            margin-bottom: 30px;
        }

        .stats-container {
            display: flex;
            gap: 30px;
            margin-bottom: 30px;
        }

        .stat-card {
            border-radius: 16px;
            padding: 27px 22px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .stat-card.total {
            background-color: #c8c8c8;
            flex: 2;
        }

        .stat-card.accepted {
            background-color: #5fd15f;
            flex: 1;
        }

        .stat-card.rejected {
            background-color: #b88b8b;
            flex: 1;
        }

        .stat-label {
            font-size: 16px;
            font-weight: bold;
            color: #000;
        }

        .stat-value {
            font-size: 48px;
            font-weight: bold;
            color: #000;
            text-align: center;
        }

        .table-container {
            background-color: #d4d4f0;
            border-radius: 20px;
            padding: 0;
            overflow: hidden;
            border: 2px solid #c5c5e0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background-color: #d4d4f0;
        }

        th {
            padding: 20px 15px;
            text-align: left;
            font-weight: bold;
            color: #000;
            font-size: 15px;
        }

        th:last-child {
            text-align: center;
        }

        td {
            padding: 20px 15px;
            background-color: #ffffff;
            border-bottom: 1px solid #d4d4f0;
        }

        td:last-child {
            text-align: center;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .file-button {
             width: 155px;          
            display: flex;
            flex-direction: row;
            justify-content: flex-start;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            background-color: white;
            border: 2px solid #ccc;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            
        }
        

        .file-icon {
            width: 20px;
            height: 20px;
            object-fit: contain;
    
        }

        .status-buttons {
            display: flex;
            gap: 5px;
            justify-content: center;
        }

        .btn {
            padding: 8px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .btn-accept {
            background-color: #00ff00;
            color: #000;
        }

        .btn-reject {
            background-color: #ff0000;
            color: #000;
        }

        .checkmark::before {
            content: '✓';
        }

        .cross::before {
            content: '✕';
        }
    </style>
</head>
